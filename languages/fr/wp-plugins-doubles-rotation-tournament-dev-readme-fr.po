msgstr "Modification des paramètres du tournoi. (WordPress)"

#. Screenshot description.
msgid "Table of players with rankings. (Android app)"
msgstr "Tableau des joueurs avec le classement. (Application Android)"

#. Screenshot description.
msgid "Matches played. (Wordpress)"
msgstr "Matchs joués. (WordPress)"

#. Screenshot description.
msgid "Basic overview of the tournament. (Android app)"
msgstr "Vue d’ensemble du tournoi. (Application Android)"

#. Screenshot description.
msgid "Matches drawn. (Wordpress)"
