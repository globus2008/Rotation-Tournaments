msgstr "Vul het aantal seconden in tussen de overgangen naar de volgende shortcode."

#: includes/doroto-admin.php:89
msgid "If you leave the field blank, the help video will not be displayed."
msgstr "Als je het veld leeg laat, wordt de helpvideo niet getoond."

#: includes/doroto-admin.php:89
msgid "Enter the YouTube video link."
msgstr "Vul de link naar de YouTube-video in."

#: includes/doroto-admin.php:89
msgid "YouTube Video Link with a help."
msgstr "Link naar YouTube-video met help."

#: includes/doroto-admin.php:88
msgid "Enter a value between 5 and 30 for the number of characters."
msgstr "Vul voor het aantal tekens een waarde tussen 5 en 30 in."

#: includes/doroto-admin.php:88
