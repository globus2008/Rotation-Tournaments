msgstr "Beállítások mentése"

#: build/admin/index.js:1 src/admin/index.js:818
msgid "Settings saved successfully!"
msgstr "A beállítások sikeresen mentve!"

#: includes/doroto-admin.php:145
msgid "This option keeps up with new plugin updates."
msgstr "Ez a beállítás lépést tart a bővítmény új frissítéseivel."

#: includes/doroto-admin.php:145
msgid "Update pages every time you activate the plugin?"
msgstr "Frissüljenek az oldalak a bővítmény minden aktiválásakor?"

#: includes/doroto-admin.php:144
msgid "Uninstall saved settings data at the same time as the plugin?"
msgstr "Törlődjenek a mentett beállítások a bővítménnyel együtt?"

#: includes/doroto-admin.php:143
msgid "If you have edited page settings, here you have the option to keep these changes even in the event of an update or uninstallation."
msgstr "Ha módosította az oldalbeállításokat, itt megtarthatja ezeket a változtatásokat frissítés vagy eltávolítás esetén is."

#: includes/doroto-admin.php:143
msgid "Uninstall tournament pages at the same time as the plugin?"
msgstr "Törlődjenek a versenyoldalak a bővítménnyel együtt?"

#: includes/doroto-admin.php:142 includes/doroto-admin.php:144
msgid "If you ever want to return to the plugin, it will be a shame to lose your data."
msgstr "Ha valaha vissza szeretne térni a bővítményhez, kár lenne elveszíteni az adatait."

#: includes/doroto-admin.php:142
msgid "Uninstall the tournament database at the same time as the plugin?"
msgstr "Törlődjön a versenyadatbázis a bővítménnyel együtt?"

#: includes/doroto-admin.php:114
msgid "Enter a value between 1 and 120 for the number of seconds."
msgstr "A másodpercek számához 1 és 120 közötti értéket adjon meg."

#: includes/doroto-admin.php:114
msgid "Enter the number of seconds as the time between transitions to show the next shortcode."
msgstr "Adja meg másodpercben a váltások közötti időt, amely után a következő rövidkód jelenik meg."

#: includes/doroto-admin.php:89
msgid "If you leave the field blank, the help video will not be displayed."
msgstr "Ha üresen hagyja a mezőt, a súgóvideó nem jelenik meg."

#: includes/doroto-admin.php:89
msgid "Enter the YouTube video link."
msgstr "Adja meg a YouTube-videó hivatkozását."

#: includes/doroto-admin.php:89
msgid "YouTube Video Link with a help."
msgstr "YouTube-videó hivatkozása súgóval."

#: includes/doroto-admin.php:88
msgid "Enter a value between 5 and 30 for the number of characters."
msgstr "A karakterek számához 5 és 30 közötti értéket adjon meg."

#: includes/doroto-admin.php:88
msgid "Enter the maximum number of characters allowed in the players display name."
msgstr "Adja meg a játékos megjelenített nevében engedélyezett karakterek maximális számát."

#: includes/doroto-admin.php:105
msgid "By default, this is enabled by everybody who is logged in. Otherwise, only an administrator, editor or author can create a tournament."
msgstr "Alapértelmezés szerint ez minden bejelentkezett felhasználó számára engedélyezett. Egyébként csak adminisztrátor, szerkesztő vagy szerző hozhat létre versenyt."

#: includes/doroto-admin.php:105
msgid "Can only a website administrator create a new tournament?"
msgstr "Csak a webhely adminisztrátora hozhat létre új versenyt?"

#: includes/doroto-admin.php:87
msgid "Enter a value between 0 and 1000 for the number of seconds."
msgstr "A másodpercek számához 0 és 1000 közötti értéket adjon meg."

#: includes/doroto-admin.php:87
msgid "Choose the time after which the page will be refreshed. Good especially when you are not the only one entering new data.. (0 = no refresh)"
msgstr "Válassza ki az időt, amely után az oldal frissül. Különösen hasznos, ha nem csak Ön ad meg új adatokat.. (0 = nincs frissítés)"

#: includes/doroto-admin.php:104
msgid "By default, this is enabled by the site administrator. Otherwise, anyone can create a post."
msgstr "Alapértelmezés szerint ez a webhely adminisztrátorának engedélyezett. Egyébként bárki létrehozhat bejegyzést."

#: includes/doroto-admin.php:104
msgid "Allow the tournament organizer to create a post to promote and administer the tournament?"
msgstr "A versenyszervező létrehozhat bejegyzést a verseny népszerűsítésére és kezelésére?"

#: includes/doroto-admin.php:86
msgid "Enter a value between 0 and 100 for display rows."
msgstr "A megjelenített sorok számához 0 és 100 közötti értéket adjon meg."

#: includes/doroto-admin.php:86
msgid "Maximum number of displayed tournaments in the table. (0 = no limit)"
msgstr "A táblázatban megjelenített versenyek maximális száma. (0 = nincs korlát)"

