msgstr "Огляд"

#: build/admin/index.js:1 src/admin/index.js:828
msgid "Some values are not allowed. Correct the marked fields."
msgstr "Деякі значення неприпустимі. Виправте позначені поля."

#: build/admin/index.js:1 src/admin/index.js:722
msgid "They keep working, so older pages do not need any change."
msgstr "Вони й далі працюють, тому старі сторінки змінювати не потрібно."

#: build/admin/index.js:1 src/admin/index.js:715
msgid "Shortcodes of the pages made before version 2.0"
msgstr "Шорткоди сторінок, створених до версії 2.0"

#: build/admin/index.js:1 src/admin/index.js:697
