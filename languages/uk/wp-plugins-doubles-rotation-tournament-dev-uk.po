msgstr "Акцент (кнопки, активна вкладка, прогрес)"

#: build/blocks/tournament-list/index.js:1 build/blocks/tournament/index.js:1 src/blocks/color-panel.js:18
msgid "Colours of the tournament"
msgstr "Кольори турніру"

#: build/blocks/invite/index.js:1 src/blocks/invite/index.js:58
msgid "Show the number of players"
msgstr "Показувати кількість гравців"

#: build/blocks/invite/index.js:1 src/blocks/invite/index.js:47
msgid "Show the invitation text"
msgstr "Показувати текст запрошення"

#: build/blocks/invite/index.js:1 build/blocks/tournament/index.js:1 src/blocks/invite/index.js:34 src/blocks/tournament/index.js:66
msgid "0 = the tournament from the address (?tournament_id=) or the latest one."
msgstr "0 = турнір з адреси (?tournament_id=) або останній турнір."

#: build/blocks/invite/index.js:1 build/blocks/tournament/index.js:1 src/blocks/invite/index.js:30 src/blocks/tournament/index.js:62
msgid "Tournament ID"
msgstr "ID турніру"

#: build/blocks/invite/index.js:1 src/blocks/invite/index.js:24
msgid "Invitation"
msgstr "Запрошення"

