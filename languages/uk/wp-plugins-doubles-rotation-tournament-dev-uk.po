#: build/blocks/tournament-list/index.js:1 build/blocks/tournament/index.js:1 src/blocks/color-panel.js:51
msgid "Without a choice the block uses the highlight colours of the theme (its buttons and palette)."
msgstr "Якщо нічого не вибрано, блок використовує кольори виділення теми (її кнопки й палітру)."

#: build/blocks/tournament-list/index.js:1 build/blocks/tournament/index.js:1 src/blocks/color-panel.js:39
