{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doroto/invite",
  "version": "2.0.0",
  "title": "Rotation tournament invitation",
  "category": "widgets",
  "icon": "groups",
  "description": "Invitation to a rotation tournament with a sign-up button and the link to share.",
  "keywords": [
    "tournament",
    "invitation",
    "sign up",
    "rotation"
  ],
  "textdomain": "doubles-rotation-tournament",
  "attributes": {
    "tournamentId": {
      "type": "integer",
      "default": 0
    },
    "showInvitation": {
      "type": "boolean",
      "default": true
    },
    "showPlayerCount": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true
    },
    "__experimentalBorder": {
      "radius": true,
      "width": true,
      "color": true
    },
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}